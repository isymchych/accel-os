#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test_dir="$repo_root/dotfiles/dot_config/emacs/tests"

ACCEL_OS="$repo_root" emacs --batch -Q \
  --directory "$repo_root/scripts" \
  --load "$repo_root/scripts/check-emacs.el"

shopt -s nullglob
test_files=("$test_dir"/*-test.el)

if (( ${#test_files[@]} == 0 )); then
  printf 'No Emacs tests found in %s\n' "$test_dir" >&2
  exit 1
fi

unit_args=()
startup_args=()
for test_file in "${test_files[@]}"; do
  case "$test_file" in
    *-startup-test.el) startup_args+=(--load "$test_file") ;;
    *) unit_args+=(--load "$test_file") ;;
  esac
done

if (( ${#unit_args[@]} > 0 )); then
  emacs --batch -Q "${unit_args[@]}" --funcall ert-run-tests-batch-and-exit
fi

if (( ${#startup_args[@]} > 0 )); then
  startup_directory="$(mktemp -d)"
  trap 'rm -rf -- "$startup_directory"' EXIT

  ACCEL_OS="$repo_root" EMACS_TEST_DIRECTORY="$startup_directory" emacs --batch -Q \
    --directory "$repo_root/scripts" \
    --load "$repo_root/scripts/check-emacs-startup.el" \
    "${startup_args[@]}" \
    --funcall ert-run-tests-batch-and-exit
fi