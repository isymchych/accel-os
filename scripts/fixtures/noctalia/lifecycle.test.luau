views["/first"] = textView("first", true)
views["/second"] = textView("second")
onOpen("/first")
assert(find(tree, function(node)
  return node.kind == "label" and node.props.text == "Preview shortened; actions use the full item."
end))
local stale = button("Save as…")
onOpen("/second")
assert(#launches == 1 and launches[1][2] == "discard" and launches[1][3] == "/first")
stale()
assert(#launches == 1, "A stale callback acted on the new snapshot")
button("Cancel")()
assert(#launches == 2 and launches[2][2] == "discard" and launches[2][3] == "/second")
onClose()
assert(#launches == 2, "Double close discarded twice")
onOpen("/second")
onExit()
assert(#launches == 3 and launches[3][2] == "discard")
