{
  "name": "@accel-os/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/electron/entry.js",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tsc --project tsconfig.build.json && node scripts/launch.ts --dev",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && vite build",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "start": "node scripts/launch.ts",
    "test": "node --experimental-test-module-mocks --test tests/integration/*.test.ts",
    "test:e2e": "pnpm run build && playwright test",
    "typecheck": "tsc --project tsconfig.json && tsc --project src/renderer/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-hotkeys": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
