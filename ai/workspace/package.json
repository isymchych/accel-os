{
  "name": "@accel-os/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev:client": "vite",
    "dev:server": "WORKSPACE_MODE=development node --watch server/app/main.ts",
    "start": "node server/app/main.ts",
    "test": "node --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project contracts/tsconfig.json && tsc --project server/tsconfig.json && tsc --project client/tsconfig.json"
  },
  "dependencies": {
    "@accel-os/shared": "0.0.0",
    "@hono/node-server": "^2.1.3",
    "@lucide/solid": "^1.58.0",
    "@solidjs/web": "2.0.0-rc.17",
    "hono": "^4.13.13",
    "solid-js": "2.0.0-rc.17",
    "typebox": "^1.1.36"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
