{
  "name": "@accel-os/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "start": "node scripts/start.ts",
    "test": "node --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project contracts/tsconfig.json && tsc --project launcher/tsconfig.json && tsc --project server/tsconfig.json && tsc --project client/tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "^1.3.0",
    "@hono/node-server": "^2.1.3",
    "@lucide/solid": "^1.58.0",
    "@solidjs/web": "^2.0.0-rc.20",
    "hono": "^4.13.13",
    "solid-js": "^2.0.0-rc.20",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solidjs/vite-plugin": "^3.0.0-next.54",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
