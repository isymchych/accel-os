{
  "name": "accel-os",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "ai/pi",
    "ai/skills",
    "packages/commands",
    "packages/shared"
  ],
  "allowScripts": {
    "koffi@2.16.2": true,
    "tilth@0.10.1": true
  },
  "scripts": {
    "fmt": "oxfmt ai/pi ai/skills packages scripts",
    "fmt:check": "oxfmt --check ai/pi ai/skills packages scripts",
    "lint": "oxlint ai/pi ai/skills packages scripts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@accel-os/shared": "0.0.0",
    "typebox": "^1.1.36",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
