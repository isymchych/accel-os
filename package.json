{
  "name": "accel-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "fmt:check:ai": "oxfmt --check ai",
    "fmt:check:commands": "oxfmt --check packages/commands",
    "lint": "pnpm -r run lint",
    "lint:ai": "oxlint ai",
    "lint:commands": "oxlint packages/commands",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": ">=0.72.0 <1.0.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  }
}
