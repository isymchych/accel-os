{{- $osID := "" -}}
{{- with .chezmoi.osRelease }}
  {{- $osID = or .id "" -}}
{{- end -}}
{{- if and (eq .chezmoi.os "linux") (eq $osID "arch") -}}
#!/usr/bin/env bash
set -euo pipefail

external_tool_names=()
external_tool_urls=()
external_tool_archive_sha256s=()
external_tool_binaries=()
external_tool_binary_sha256s=()

while IFS=$'\t' read -r record name url archive_sha256 binary binary_sha256 extra; do
  if [[ "$record" != external_tool ]]; then
    continue
  fi
  if [[ -n "$extra" || -z "$name" || -z "$url" || -z "$archive_sha256" || -z "$binary" || -z "$binary_sha256" ]]; then
    printf 'Invalid external tool record: %s\n' "$record" >&2
    exit 1
  fi
  external_tool_names+=("$name")
  external_tool_urls+=("$url")
  external_tool_archive_sha256s+=("$archive_sha256")
  external_tool_binaries+=("$binary")
  external_tool_binary_sha256s+=("$binary_sha256")
done <<'ACCEL_OS_RESOLVED_EXTERNAL_TOOLS'
{{ template "resolved-external-tools" . -}}
ACCEL_OS_RESOLVED_EXTERNAL_TOOLS

readonly target_directory="$HOME/.local/bin"
temporary_directories=()

cleanup() {
  local directory

  for directory in "${temporary_directories[@]}"; do
    rm -rf "$directory"
  done
}
trap cleanup EXIT

install_external_tool() {
  local name=$1
  local url=$2
  local archive_sha256=$3
  local binary=$4
  local binary_sha256=$5
  local temporary_directory
  local archive_path
  local extracted_directory
  local source_path
  local staged_path
  local actual_binary_sha256

  temporary_directory="$(mktemp -d)"
  temporary_directories+=("$temporary_directory")
  archive_path="$temporary_directory/$name.tar.gz"
  extracted_directory="$temporary_directory/extracted"
  mkdir -p "$extracted_directory"

  wget \
    --https-only \
    --secure-protocol=TLSv1_2 \
    --quiet \
    --output-document="$archive_path" \
    "$url"
  printf '%s  %s\n' "$archive_sha256" "$archive_path" | sha256sum --check --status

  tar \
    --extract \
    --gzip \
    --file "$archive_path" \
    --directory "$extracted_directory" \
    --no-same-owner \
    --no-same-permissions

  source_path="$extracted_directory/$binary"
  if [[ ! -f "$source_path" || -L "$source_path" ]]; then
    printf 'External tool %s archive does not contain a regular %s binary\n' "$name" "$binary" >&2
    return 1
  fi

  actual_binary_sha256="$(sha256sum "$source_path" | awk '{print $1}')"
  if [[ "$actual_binary_sha256" != "$binary_sha256" ]]; then
    printf 'External tool %s binary checksum mismatch\n' "$name" >&2
    return 1
  fi

  mkdir -p "$target_directory"
  staged_path="$(mktemp "$target_directory/.${name}.XXXXXX")"
  install --mode=0755 "$source_path" "$staged_path"
  mv --force "$staged_path" "$target_directory/$binary"
}

for index in "${!external_tool_names[@]}"; do
  target_path="$target_directory/${external_tool_binaries[$index]}"
  expected_binary_sha256="${external_tool_binary_sha256s[$index]}"
  if [[ -f "$target_path" && ! -L "$target_path" && -x "$target_path" ]]; then
    actual_binary_sha256="$(sha256sum "$target_path" | awk '{print $1}')"
    if [[ "$actual_binary_sha256" == "$expected_binary_sha256" ]]; then
      continue
    fi
  fi

  install_external_tool \
    "${external_tool_names[$index]}" \
    "${external_tool_urls[$index]}" \
    "${external_tool_archive_sha256s[$index]}" \
    "${external_tool_binaries[$index]}" \
    "${external_tool_binary_sha256s[$index]}"
done
{{- end }}