{
  "name": "@accel-os/dotfiles",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "check:completions": "node scripts/check-completions.ts",
    "check:emacs": "node scripts/emacs/check-emacs.ts",
    "check:host-config": "node scripts/check-host-config.ts",
    "doctor": "node scripts/doctor.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "node --test 'tests/**/*.test.ts'",
    "test:noctalia": "node --test 'tests/noctalia/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@accel-os/shared": "workspace:*",
    "typebox": "catalog:",
    "yaml": "^2.9.0"
  }
}
