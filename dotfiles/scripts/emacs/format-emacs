#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
scripts_dir="$repo_root/dotfiles/scripts/emacs"

case "${1:-}" in
  "")
    mode="write"
    ;;
  --check)
    mode="check"
    ;;
  *)
    printf 'Usage: %s [--check]\n' "$0" >&2
    exit 2
    ;;
esac

ACCEL_OS="$repo_root" EMACS_FORMAT_MODE="$mode" \
  exec emacs --batch -Q \
  --directory "$scripts_dir" \
  --load "$scripts_dir/format-emacs.el"