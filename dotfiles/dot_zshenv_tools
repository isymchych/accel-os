# Baseline environment for repo-managed commands in every Zsh context.
export ACCEL_OS="${ACCEL_OS:-$HOME/accel-os}"
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$ACCEL_OS/ai/pi}"
export PI_CACHE_RETENTION="${PI_CACHE_RETENTION:-long}"
export DFT_BACKGROUND="${DFT_BACKGROUND:-light}"

typeset -gU path
path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/.npm-global/bin"
  "$HOME/.cargo/bin"
  $path
)
