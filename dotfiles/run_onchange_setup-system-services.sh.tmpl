{{- $osID := "" -}}
{{- with .chezmoi.osRelease }}
  {{- $osID = or .id "" -}}
{{- end -}}
{{- if and (eq .chezmoi.os "linux") (eq $osID "arch") -}}
#!/usr/bin/env bash
set -euo pipefail

{{ template "load-resolved-host-state.sh" . }}

if (( ! known_host )); then
printf 'Warning: host %s is not declared in hosts.yaml; enabling base services only.\n' \
  "$resolved_hostname" >&2
fi

assert_disjoint() {
  local enabled_name=$1
  local disabled_name=$2
  local -n enabled=$enabled_name
  local -n disabled=$disabled_name
  local enabled_service
  local disabled_service

  for enabled_service in "${enabled[@]}"; do
    for disabled_service in "${disabled[@]}"; do
      if [[ "$enabled_service" == "$disabled_service" ]]; then
        printf 'Service %s is configured as both enabled and disabled.\n' \
          "$enabled_service" >&2
        exit 1
      fi
    done
  done
}

assert_disjoint enabled_system_services disabled_system_services
assert_disjoint enabled_user_services disabled_user_services

if [ "${#enabled_system_services[@]}" -gt 0 ]; then
  sudo systemctl enable --now "${enabled_system_services[@]}"
fi

if [ "${#enabled_user_services[@]}" -gt 0 ]; then
  systemctl --user enable --now "${enabled_user_services[@]}"
fi

for service in "${disabled_system_services[@]}"; do
  if systemctl cat "$service" >/dev/null 2>&1; then
    unit_file_state=$(systemctl show --property=UnitFileState --value "$service")
    case "$unit_file_state" in
      masked|masked-runtime) sudo systemctl stop "$service" ;;
      *) sudo systemctl disable --now "$service" ;;
    esac
  fi
done

for service in "${disabled_user_services[@]}"; do
  if systemctl --user cat "$service" >/dev/null 2>&1; then
    unit_file_state=$(systemctl --user show --property=UnitFileState --value "$service")
    case "$unit_file_state" in
      masked|masked-runtime) systemctl --user stop "$service" ;;
      *) systemctl --user disable --now "$service" ;;
    esac
  fi
done
{{ end }}