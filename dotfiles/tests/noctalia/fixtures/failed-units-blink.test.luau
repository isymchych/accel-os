local refresh = loadService()
local first, tickFirst, clickFirst = loadWidget()
local second, tickSecond = loadWidget(true)
assert(interval == 750 and first.text == nil and first.visible)
tickFirst()
assert(#commands == 1, "Blinking must not start queries")
success("alpha.service loaded failed failed Alpha\nbeta.service loaded failed failed Beta\n")
success("alpha.service loaded failed failed User Alpha\n")
assert(first.glyph == "alert-triangle" and second.glyph == "alert-triangle")
assert(first.text == nil and second.text == nil, "Both bar layouts show only the icon")
tickSecond()
assert(second.glyphColor == "error_container")
tickFirst()
assert(first.glyphColor == "error_container" and first.visible)
tickFirst()
assert(first.glyphColor == "error" and first.text == nil)
clickFirst()
tickFirst()
tickSecond()
assert(first.glyphColor == "error" and second.glyphColor == "error", "Click acknowledges all bars")
assertArgs(launches[1], {
  "xterm", "run", "--class=systemd-manager", "--",
  "systemctl-tui", "--scope", "all", "--no-log", "--limit-units", "*",
})

refresh()
success("alpha.service loaded failed failed Alpha\nbeta.service loaded failed failed Beta\n")
success("alpha.service loaded failed failed User Alpha\n")
assert(#notices == 3 and first.glyphColor == "error", "Unchanged failures stay acknowledged")
-- A replacement with the same total must still notify and re-arm blinking.
refresh()
success("alpha.service loaded failed failed Alpha\nbeta.service loaded failed failed Beta\n")
success("gamma.service loaded failed failed Gamma\n")
assert(first.visible and #notices == 4 and notices[4].argv[5] == "user: gamma.service")
tickFirst()
assert(first.glyphColor == "error_container" and first.visible)
