views["/snapshot"] = textView("<script>not markup</script>\nSecond line")
onOpen("/snapshot")
local preview = find(tree, function(node)
  return node.kind == "label" and node.props.text == views["/snapshot"].text
end)
assert(preview and preview.props.maxLines > 1)
assert(not find(tree, function(node) return node.kind == "markdown" end))
local save = button("Save as…")
save()
assert(closed == 1 and #launches == 1)
assert(launches[1][1] == "/plugins/clipboard-actions/actions")
assert(launches[1][2] == "run" and launches[1][3] == "/snapshot" and launches[1][4] == "save")
save()
onExit()
assert(#launches == 1, "Double activation or onExit discarded an action-owned snapshot")
