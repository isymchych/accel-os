local refresh = loadService()
assert(interval == 10000)
assertArgs(commands[1].argv, { "systemctl", "--failed", "--no-legend", "--plain", "--no-pager" })
local first = loadWidget()
local second = loadWidget()
refresh()
assert(#commands == 1, "Overlapping refreshes must not start queries")
success("alpha.service loaded failed failed Alpha\n\n  \t\nbeta.service loaded failed failed Beta\n")
assertArgs(commands[1].argv, { "systemctl", "--user", "--failed", "--no-legend", "--plain", "--no-pager" })
success("alpha.service loaded failed failed User Alpha\n")
assert(first.text == nil and second.text == nil and first.visible and second.visible and #logs == 0)
assert(first.glyph == "alert-triangle")
assert(first.tooltip == "system: alpha.service\nsystem: beta.service\nuser: alpha.service")
assert(#notices == 3, "Notify once per scoped unit, not per bar")
assertArgs(notices[1].argv, {
  "notify-send", "--app-name=Systemd failures", "--urgency=critical",
  "Systemd unit failed", "system: alpha.service",
})
assert(notices[3].argv[5] == "user: alpha.service")

refresh()
success("alpha.service loaded failed failed Alpha\nbeta.service loaded failed failed Beta\n")
success("alpha.service loaded failed failed User Alpha\n")
assert(#notices == 3, "Unchanged failures do not repeat notifications")
local third = loadWidget()
assert(third.visible and #notices == 3, "New bars never send notifications")
refresh = loadService()
success("alpha.service loaded failed failed Alpha\nbeta.service loaded failed failed Beta\n")
success("alpha.service loaded failed failed User Alpha\n")
assert(#notices == 3, "Service reload retains its successful snapshot")
refresh()
success("")
success("")
assert(not first.visible and not second.visible)
refresh()
success("")
success("alpha.service loaded failed failed User Alpha\n")
assert(first.visible and #notices == 4, "Recurrence alerts again")
