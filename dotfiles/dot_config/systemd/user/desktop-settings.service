[Unit]
Description=Static desktop settings for Sway
PartOf=sway-session.target
After=sway-session.target graphical-session.target
Before=noctalia.service nm-applet.service udiskie.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface cursor-theme Adwaita
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface font-name "Noto Sans 14"
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface gtk-key-theme Default
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface scaling-factor 1
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface text-scaling-factor 1
