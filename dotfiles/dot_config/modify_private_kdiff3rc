#!/usr/bin/env bash
set -euo pipefail

# Own preferences only; KDiff3 owns window state, history, and unknown settings.
# Read values as literal lines so KDE's backslash escapes survive unchanged.
awk '
  function missing(    i, key) {
    for (i = 1; i <= count; i++) {
      key = order[i]
      if (!(key in seen)) {
        print preferences[key]
        seen[key] = 1
      }
    }
  }
  NR == FNR {
    key = substr($0, 1, index($0, "=") - 1)
    order[++count] = key
    preferences[key] = $0
    next
  }
  /^\[/ {
    if (in_options) missing()
    in_options = ($0 == "[KDiff3 Options]")
    if (in_options) found = 1
  }
  {
    key = substr($0, 1, index($0, "=") - 1)
    if (in_options && key in preferences) {
      print preferences[key]
      seen[key] = 1
    } else {
      print
    }
  }
  END {
    if (!found) print "[KDiff3 Options]"
    missing()
  }
' /dev/fd/3 - 3<<'PREFERENCES'
