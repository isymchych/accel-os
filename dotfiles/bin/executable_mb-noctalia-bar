#!/usr/bin/env bash
# zsh-completion: completions/_mb-no-args

set -euo pipefail

state_file="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must be set}/mb-noctalia-bar-mode"
session=$(systemctl --user show noctalia.service --property=InvocationID --value)
if [[ -z "$session" || "$session" =~ ^0+$ ]]; then
  printf '%s\n' 'Noctalia service is not running.' >&2
  exit 1
fi

enabled=$(noctalia msg config-get bar.right.enabled)
case "$enabled" in
  true)
    bar=right
    state_file="$state_file-right"
    ;;
  false) bar=default ;;
  *) printf 'Unexpected bar.right.enabled value: %s\n' "$enabled" >&2; exit 1 ;;
esac

mode=on
if [[ -f "$state_file" && "$(<"$state_file")" == "$session on" ]]; then
  mode=off
fi

noctalia msg bar-show "$bar"
noctalia msg bar-auto-hide-set "$mode" "$bar"
noctalia msg bar-reserve-toggle "$bar"
printf '%s %s\n' "$session" "$mode" >"$state_file"
