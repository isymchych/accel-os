#!/usr/bin/env bash

set -euo pipefail

: "${ACCEL_OS:?ACCEL_OS must point at repo root}"

readonly node="$ACCEL_OS/node_modules/.bin/node"

[[ -x "$node" ]] || {
  printf 'accel-node: missing repo-managed Node; run pnpm install --frozen-lockfile in %s\n' "$ACCEL_OS" >&2
  exit 1
}

# Keep the caller's cwd and process identity, and use the pinned runtime in children.
export PATH="$ACCEL_OS/node_modules/.bin:$PATH"
exec "$node" "$@"
