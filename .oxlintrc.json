{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript", "react", "jsx-a11y"],
  "ignorePatterns": ["ai/pagoda/dist/**"],
  "env": {
    "node": true
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "class-methods-use-this": "off",
    "max-classes-per-file": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "no-await-in-loop": "off",
    "no-console": "off",
    "no-empty-function": "off",
    "no-inline-comments": "off",
    "no-use-before-define": "off",
    "no-undefined": "off",
    "no-void": "off",
    "react/forbid-component-props": "off",
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [".tsx"]
      }
    ],
    "react/jsx-no-literals": "off",
    "react/no-multi-comp": "off",
    "react/only-export-components": "off",
    "react/react-in-jsx-scope": "off",
    "require-await": "off",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-condition": [
      "error",
      {
        "allowConstantLoopConditions": "only-allowed-literals"
      }
    ],
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/promise-function-async": "off",
    "typescript/require-await": "off",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableBoolean": true,
        "allowNullableString": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*"],
      "excludeFiles": ["ai/pagoda/src/renderer/**/*.ts", "ai/pagoda/src/renderer/**/*.tsx"],
      "plugins": ["typescript"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    },
    {
      "files": ["ai/pagoda/src/renderer/**/*.ts", "ai/pagoda/src/renderer/**/*.tsx"],
      "env": {
        "browser": true,
        "node": false
      },
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "client code must not import Node modules"
              },
              {
                "regex": "^(?:\\.\\./)+(?:electron/|backend/|(?:\\.\\./)*scripts/)",
                "message": "client code must use desktop contracts, not privileged implementation"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["ai/pagoda/src/contracts/**/*.ts"],
      "env": {
        "browser": false,
        "node": false
      },
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "contracts must not import Node modules"
              },
              {
                "regex": "^(?:\\./|(?:\\.\\./)+)(?:renderer/|electron/|backend/|(?:\\.\\./)*scripts/)",
                "message": "contracts must not import application code"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["ai/pagoda/src/backend/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["electron"],
                "message": "backend code must not import Electron"
              },
              {
                "regex": "^(?:\\.\\./)+(?:renderer|electron)/",
                "message": "backend code must not import renderer or Electron implementation"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["ai/pagoda/src/electron/**/*.ts", "ai/pagoda/src/electron/**/*.cts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+renderer/",
                "message": "Electron code must not import client implementation"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["ai/pagoda/scripts/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+src/(?:renderer|electron|backend)/",
                "message": "the launcher must launch the app, not import its implementation"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
