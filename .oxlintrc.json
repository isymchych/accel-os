{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "perf": "error",
    "restriction": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript"],
  "ignorePatterns": ["ai/workspace/dist/**", "ai/workspace/.workspace/**"],
  "env": {
    "node": true
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "class-methods-use-this": "off",
    "no-await-in-loop": "off",
    "no-console": "off",
    "no-empty-function": "off",
    "no-use-before-define": "off",
    "no-undefined": "off",
    "no-void": "off",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-condition": [
      "error",
      {
        "allowConstantLoopConditions": "only-allowed-literals"
      }
    ],
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableBoolean": true,
        "allowNullableString": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["ai/workspace/client/**/*.ts", "ai/workspace/client/**/*.tsx"],
      "env": {
        "browser": true,
        "node": false
      },
      "globals": {
        "__BUILD_ID__": "readonly"
      },
      "rules": {
        "no-underscore-dangle": ["error", { "allow": ["__BUILD_ID__"] }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "client code must not import Node modules"
              },
              {
                "regex": "^(?:\\.\\./)+(?:server|launcher)/",
                "allowTypeImports": true,
                "message": "client code must not import server or launcher code"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["ai/workspace/contracts/**/*.ts"],
      "env": {
        "browser": false,
        "node": false
      },
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "contracts must not import Node modules"
              },
              {
                "regex": "^(?:\\.\\./)+(?:client|server|launcher)/",
                "message": "contracts must not import application code"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["ai/workspace/server/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+client/",
                "message": "server code must not import client code"
              },
              {
                "regex": "^(?:\\.\\./)+launcher/",
                "message": "application code must use launcher contracts, not launcher implementation"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["ai/workspace/launcher/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+(?:client|server)/",
                "message": "launcher code must not import application implementation"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
